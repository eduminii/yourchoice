// deltas per section 7-2 of the design doc
const DELTA = {
  checkThink:   {ji:+5, ri:+1},  // 근거 확인 후 직접 판단
  checkFollow:  {ji:+5, ri: 0},  // 근거 확인 후 AI 추천 수용
  skipFollow:   {ji:-5, ri:-1},  // 무근거 무조건 수용
  skipThink:    {ji:-5, ri: 0},  // 무근거 무조건 거부
