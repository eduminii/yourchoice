<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>책임 인생게임</title>
<style>
  :root{
    --ink:#111111;
    --bg:#F2EFE9;
    --yellow:#FFD500;
    --pink:#FF6EC7;
    --cyan:#00E5FF;
    --lime:#B6FF3B;
    --red:#FF4B3E;
    --purple:#B69CFF;
    --shadow-off: 6px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--bg);
    background-image:
      linear-gradient(var(--ink) 1px, transparent 1px),
      linear-gradient(90deg, var(--ink) 1px, transparent 1px);
    background-size: 28px 28px;
    background-position: -1px -1px;
    color:var(--ink);
    font-family: "Pretendard","Malgun Gothic","Apple SD Gothic Neo",system-ui,sans-serif;
    min-height:100vh;
  }
  .wrap{
    max-width:920px;
    margin:0 auto;
    padding:20px 16px 60px;
  }
  .brutal{
    background:#fff;
    border:4px solid var(--ink);
    box-shadow: var(--shadow-off) var(--shadow-off) 0 var(--ink);
  }
  .btn{
    display:inline-block;
    font-weight:900;
    font-size:16px;
    padding:14px 20px;
    background:var(--yellow);
    border:4px solid var(--ink);
    box-shadow: var(--shadow-off) var(--shadow-off) 0 var(--ink);
    cursor:pointer;
    color:var(--ink);
    text-align:center;
    transition: transform .08s ease;
    user-select:none;
  }
  .btn:active{
    transform: translate(4px,4px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .btn.pink{background:var(--pink);}
  .btn.cyan{background:var(--cyan);}
  .btn.lime{background:var(--lime);}
  .btn.red{background:var(--red); color:#fff;}
  .btn:disabled{opacity:.35; cursor:not-allowed;}
  .btn.full{display:block; width:100%; margin-bottom:12px;}

  h1{
    font-size:34px;
    font-weight:900;
    margin:10px 0 4px;
    letter-spacing:-0.5px;
    text-transform:uppercase;
  }
  h2{
    font-size:22px;
    font-weight:900;
    text-transform:uppercase;
    margin:0 0 14px;
    background:var(--ink);
    color:#fff;
    display:inline-block;
    padding:4px 10px;
    transform:rotate(-1deg);
  }
  .tag{
    display:inline-block;
    font-size:11px;
    font-weight:900;
    text-transform:uppercase;
    background:var(--ink);
    color:#fff;
    padding:3px 8px;
    margin:2px 4px 2px 0;
    transform:rotate(-2deg);
  }
  .tag.warn{background:var(--red);}
  .card-panel{
    padding:22px;
    margin-bottom:18px;
    transform:rotate(-0.4deg);
  }
  .subtle{opacity:.75; font-size:14px; font-weight:600;}

  /* header / gauges */
  header.top{
    padding:14px 16px;
    margin-bottom:20px;
  }
  .charrow{display:flex; align-items:center; gap:12px; margin-bottom:14px;}
  .avatar{
    font-size:34px;
    width:56px;height:56px;
    display:flex;align-items:center;justify-content:center;
    background:var(--lime);
    border:4px solid var(--ink);
    box-shadow:4px 4px 0 var(--ink);
  }
  .progresswrap{font-size:12px; font-weight:900; margin-left:auto; text-align:right;}

  .gauges{display:grid; grid-template-columns:1fr 1fr; gap:14px;}
  .gauge{position:relative;}
  .gauge-label{
    display:flex; justify-content:space-between;
    font-weight:900; font-size:13px; text-transform:uppercase; margin-bottom:6px;
  }
  .gauge-track{
    position:relative;
    height:26px;
    background:#fff;
    border:4px solid var(--ink);
    overflow:visible;
  }
  .gauge-fill{
    height:100%;
    width:50%;
    background:var(--cyan);
    transition: width .7s cubic-bezier(.2,.9,.2,1.2);
    position:relative;
  }
  .gauge.ri .gauge-fill{background:var(--pink);}
  .gauge-track.shake{ animation: shakeX .4s; }
  @keyframes shakeX{
    0%,100%{transform:translateX(0);}
    20%{transform:translateX(-6px);}
    40%{transform:translateX(6px);}
    60%{transform:translateX(-4px);}
    80%{transform:translateX(4px);}
  }
  .gauge-track.flashpos{ animation: flashG .5s; }
  .gauge-track.flashneg{ animation: flashR .5s; }
  @keyframes flashG{ 0%{background:var(--lime);} 100%{background:#fff;} }
  @keyframes flashR{ 0%{background:var(--red);} 100%{background:#fff;} }

  .popup{
    position:absolute;
    right:6px; top:-6px;
    font-weight:900;
    font-size:16px;
    padding:2px 8px;
    border:3px solid var(--ink);
    background:var(--yellow);
    box-shadow:3px 3px 0 var(--ink);
    animation: floatUp 1.1s ease forwards;
    pointer-events:none;
    z-index:5;
  }
  .popup.neg{background:var(--red); color:#fff;}
  @keyframes floatUp{
    0%{ transform:translateY(0) scale(1); opacity:1; }
    70%{ transform:translateY(-30px) scale(1.1); opacity:1; }
    100%{ transform:translateY(-42px) scale(1); opacity:0; }
  }

  /* board */
  .board{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    margin-bottom:18px;
  }
  .tile{
    width:58px;height:58px;
    display:flex;align-items:center;justify-content:center;
    font-weight:900; font-size:11px;
    background:#fff;
    border:3px solid var(--ink);
    position:relative;
    text-align:center;
  }
  .tile.done{background:var(--lime);}
  .tile.now{background:var(--yellow); box-shadow:4px 4px 0 var(--ink); transform:scale(1.08);}
  .tile .token{position:absolute; top:-14px; font-size:20px;}

  .dice-face{
    font-size:64px; line-height:1; margin:8px 0 16px;
    display:inline-block;
  }
  .dice-face.landed{ animation: diceLand .4s; }
  @keyframes diceLand{
    0%{ transform:scale(1.4) rotate(-8deg); }
    60%{ transform:scale(0.9) rotate(4deg); }
    100%{ transform:scale(1) rotate(0deg); }
  }
  .dice-result{
    font-weight:900; font-size:13px; text-transform:uppercase;
    background:var(--yellow); border:3px solid var(--ink);
    display:inline-block; padding:4px 10px; margin-bottom:10px;
  }
  .evlist{ list-style:none; padding:0; margin:0 0 4px; }
  .evlist .ev{
    padding:9px 11px; margin-bottom:7px; font-weight:700; font-size:13.5px;
    border:3px solid var(--ink);
  }
  .evlist .ev.support{ background:#E9FBD3; }
  .evlist .ev.against{ background:#FFE3DC; }
  .evlist .ev.locked{ background:#eee; color:#888; font-style:italic; border-style:dashed; }

  .choicegrid{display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:16px;}
  @media (max-width:560px){ .choicegrid{grid-template-columns:1fr;} .gauges{grid-template-columns:1fr;} }

  .outcome-badge{
    display:inline-block; font-weight:900; font-size:20px;
    padding:6px 14px; margin-bottom:10px;
    border:4px solid var(--ink); transform:rotate(-2deg);
  }
  .outcome-badge.success{background:var(--lime);}
  .outcome-badge.fail{background:var(--red); color:#fff;}

  select, textarea{
    width:100%;
    font-family:inherit;
    font-size:15px;
    font-weight:700;
    padding:12px;
    border:4px solid var(--ink);
    background:#fff;
    box-shadow:4px 4px 0 var(--ink);
  }
  textarea{resize:vertical; min-height:80px;}

  .charpick{
    display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin:18px 0;
  }
  .charcard{
    padding:16px 8px; text-align:center; cursor:pointer;
    background:#fff; border:4px solid var(--ink);
    box-shadow:5px 5px 0 var(--ink);
    transition:transform .1s;
  }
  .charcard:hover{transform:translate(-2px,-2px);}
  .charcard.sel{background:var(--yellow); transform:translate(3px,3px); box-shadow:2px 2px 0 var(--ink);}
  .charcard .em{font-size:34px; display:block; margin-bottom:6px;}
  .charcard .nm{font-weight:900; font-size:13px;}

  .hidden{display:none !important;}

  .endinghero{
    text-align:center; padding:30px 20px; margin-bottom:18px;
  }
  .endinghero .em{font-size:64px; display:block;}
  .endinghero h1{margin-top:8px;}
  .statbar{display:flex; justify-content:center; gap:26px; margin:14px 0;}
  .statbox{text-align:center;}
  .statbox .num{font-size:30px; font-weight:900;}
  .statbox .lab{font-size:12px; font-weight:800; text-transform:uppercase;}

  .reasonlist{list-style:none; padding:0; margin:0;}
  .reasonlist li{
    padding:10px 12px; margin-bottom:8px; border:3px solid var(--ink);
    font-weight:700; font-size:14px; background:var(--bg);
  }
  .reasonlist li b{background:var(--yellow); padding:0 4px;}

  footer.credit{text-align:center; font-size:12px; opacity:.5; margin-top:30px; font-weight:700;}
</style>
</head>
<body>
<div class="wrap" id="app"></div>

<script>
