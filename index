  {cat:'사법', tag:'데이터 편향',
   situ:'가석방 심사 모의 활동, AI가 재범 위험도 점수를 준다.',
   detail:'마지막 활동, 가석방 심사위원회 역할극이다. AI가 재범 위험도 점수를 화면에 띄운다.',
   ai:'"재범 위험도 낮음, 가석방을 추천해."',
   flaw:'재범 위험도 산출에 쓰인 과거 데이터 자체에 편향이 있을 수 있다.',
   evidence:[
     {text:'재범 위험도 점수는 나이, 전과, 사회적 지원 여부 등을 종합해 산출된다.', supportsAI:true},
     {text:'이 점수 산출에 쓰인 과거 데이터는 특정 계층에게 불리하게 작용했다는 연구 결과가 있다.', supportsAI:false},
     {text:'대상자가 최근 안정적인 직장을 구했다는 최신 정보는 아직 반영되지 않았다.', supportsAI:false},
   ],
   success:0.5, succTxt:'신중한 논의 끝에 설득력 있는 결론을 냈다.',
   failTxt:'중요한 변수를 놓쳐 결론이 뒤집혔다.'},
];

const DICE_FACES = ['','⚀','⚁','⚂','⚃','⚄','⚅'];

/* ---------------- STATE ---------------- */
let S = {
  screen:'intro',
  charId:null,
  idx:0,
  RI:50, JI:50,
  history:[], // {cat, checked, followed, success, reaction}
  pendingCard:null,
  pendingChoice:{},
};

function counts(){
  const c = {checkThink:0, checkFollow:0, skipFollow:0, skipThink:0, ownIt:0, blameAI:0, fails:0};
  S.history.forEach(h=>{
    c[h.actionKey]++;
    if(h.reaction) c[h.reaction]++;
    if(!h.success) c.fails++;
  });
  return c;
}

/* ---------------- RENDER ---------------- */
const app = document.getElementById('app');

function render(){
  if(S.screen==='intro') return renderIntro();
  if(S.screen==='char') return renderChar();
  if(S.screen==='board') return renderBoard();
  if(S.screen==='card') return renderCard();
  if(S.screen==='outcome') return renderOutcome();
  if(S.screen==='reaction') return renderReaction();
  if(S.screen==='ending') return renderEnding();
}

function header(showGauges){
  const ch = CHARACTERS.find(c=>c.id===S.charId) || CHARACTERS[0];
  return `
  <header class="top brutal">
    <div class="charrow">
      <div class="avatar">${ch.em}</div>
      <div>
        <div style="font-weight:900; font-size:16px;">${ch.name}</div>
        <div class="subtle">책임 인생게임</div>
      </div>
      <div class="progresswrap">${S.idx}/${CARDS.length} 칸<br><span class="subtle">진행률</span></div>
    </div>
    ${showGauges ? `
    <div class="gauges">
      <div class="gauge ri">
        <div class="gauge-label"><span>책임감 지수 RI</span><span id="ri-val">${S.RI}</span></div>
        <div class="gauge-track" id="ri-track"><div class="gauge-fill" id="ri-fill" style="width:${S.RI}%"></div></div>
      </div>
      <div class="gauge ji">
        <div class="gauge-label"><span>판단력 지수 JI</span><span id="ji-val">${S.JI}</span></div>
        <div class="gauge-track" id="ji-track"><div class="gauge-fill" id="ji-fill" style="width:${S.JI}%; background:var(--cyan);"></div></div>
      </div>
    </div>` : ''}
  </header>`;
}

function renderIntro(){
  app.innerHTML = `
    <div class="brutal card-panel">
      <h1>책임 인생게임</h1>
      <p class="subtle">AI 조력자와 함께 인생의 갈림길을 통과하세요.<br>매 순간 "AI를 따를 것인가, 스스로 판단할 것인가"가 당신의 엔딩을 결정합니다.</p>
      <div style="margin:16px 0;">
        <span class="tag">일상 6칸</span><span class="tag">의료 3칸</span><span class="tag">사법 3칸</span>
      </div>
      <div class="btn full" onclick="go('char')">게임 시작 →</div>
    </div>`;
}

function renderChar(){
  app.innerHTML = `
    <div class="brutal card-panel">
      <h2>캐릭터 선택</h2>
      <p class="subtle">함께할 주인공을 골라주세요.</p>
      <div class="charpick">
        ${CHARACTERS.map(c=>`
          <div class="charcard ${S.charId===c.id?'sel':''}" onclick="pickChar('${c.id}')">
            <span class="em">${c.em}</span>
            <span class="nm">${c.name}</span>
          </div>`).join('')}
      </div>
      <div class="btn full ${S.charId?'lime':''}" style="${S.charId?'':'opacity:.4;pointer-events:none;'}" onclick="startBoard()">모험 떠나기 →</div>
    </div>`;
}
function pickChar(id){ S.charId=id; render(); }
function startBoard(){ if(!S.charId) return; S.screen='board'; render(); }

function renderBoard(){
  const tiles = CARDS.map((c,i)=>{
    let cls='tile';
    if(i<S.idx) cls+=' done';
    if(i===S.idx) cls+=' now';
    const ch = CHARACTERS.find(x=>x.id===S.charId);
    return `<div class="${cls}">${i+1}. ${c.cat}${i===S.idx?`<span class="token">${ch.em}</span>`:''}</div>`;
  }).join('');
  app.innerHTML = `
    ${header(true)}
    <div class="brutal card-panel" style="text-align:center;">
      <h2>${S.idx+1}번째 칸 도착</h2>
      <p class="subtle">주사위를 굴려 사건을 확인하세요. 눈이 클수록 AI 추천의 숨은 근거를 더 많이 미리 볼 수 있습니다.</p>
      <div class="board" style="justify-content:center; margin:16px 0;">${tiles}</div>
      <div class="dice-face" id="dice-face">🎲</div>
      <div class="btn lime" id="dice-btn" onclick="rollDice()">주사위 굴리기</div>
    </div>`;
}

function rollDice(){
  const btn = document.getElementById('dice-btn');
  const face = document.getElementById('dice-face');
  btn.setAttribute('disabled','disabled');
  face.classList.remove('landed');
  let ticks = 0;
  const iv = setInterval(()=>{
    const f = 1+Math.floor(Math.random()*6);
    face.textContent = DICE_FACES[f];
    ticks++;
    if(ticks>12){
      clearInterval(iv);
      const roll = 1+Math.floor(Math.random()*6);
      face.textContent = DICE_FACES[roll];
      face.classList.add('landed');
      setTimeout(()=>afterRoll(roll), 550);
    }
  }, 80);
}

function afterRoll(roll){
  const card = CARDS[S.idx];
  const revealedCount = Math.ceil(roll/2); // 1~2눈:1개, 3~4눈:2개, 5~6눈:3개(전부)
  const order = [0,1,2].sort(()=>Math.random()-0.5);
  S.pendingCard = card;
  S.pendingChoice = {};
  S.roll = roll;
  S.revealOrder = order;
  S.revealedSet = new Set(order.slice(0, revealedCount));
  S.screen='card';
  render();
}

function evidenceListHTML(){
  const c = S.pendingCard;
  return c.evidence.map((ev,i)=>{
    const revealed = S.revealedSet.has(i);
    if(!revealed){
      return `<li class="ev locked">🔒 아직 확인되지 않은 근거</li>`;
    }
    return `<li class="ev ${ev.supportsAI?'support':'against'}">${ev.supportsAI?'👍':'⚠️'} ${ev.text}</li>`;
  }).join('');
}

function renderCard(){
  const c = S.pendingCard;
  const revealedCount = S.revealedSet.size;
  app.innerHTML = `
    ${header(true)}
    <div class="brutal card-panel">
      <span class="tag">${c.cat} 카드</span><span class="tag warn">${c.tag}</span>
      <h2>${S.idx+1}번째 사건</h2>
      <p style="font-weight:700; font-size:16px;">${c.detail}</p>
      <div class="brutal" style="padding:14px; background:var(--purple); margin:14px 0;">
        <b>🤖 AI 조력자:</b> ${c.ai}
      </div>
      <div class="dice-result">🎲 주사위 결과 ${S.roll} → 근거 ${revealedCount}/${c.evidence.length}개 자동 공개</div>
      <ul class="evlist" id="evlist">${evidenceListHTML()}</ul>
      <p class="subtle" style="margin-top:14px;">나머지 근거까지 직접 확인해볼까요?</p>
      <div class="choicegrid">
        <div class="btn cyan" onclick="setStep1(true)">🔍 근거부터 확인한다</div>
        <div class="btn" onclick="setStep1(false)">⚡ 바로 결정한다</div>
      </div>
    </div>
    <div id="step2wrap"></div>`;
}

function setStep1(checked){
  S.pendingChoice.checked = checked;
  if(checked){
    S.pendingCard.evidence.forEach((_,i)=>S.revealedSet.add(i));
    document.getElementById('evlist').innerHTML = evidenceListHTML();
  }
  const wrap = document.getElementById('step2wrap');
  wrap.innerHTML = `
    <div class="brutal card-panel">
      <p class="subtle">${checked ? '숨어있던 근거까지 모두 확인했습니다. 이제 어떻게 할까요?' : '근거 확인 없이 바로 정해야 합니다.'}</p>
      <div class="choicegrid">
        <div class="btn pink" onclick="setStep2(true)">🤖 AI를 따른다</div>
        <div class="btn lime" onclick="setStep2(false)">🧠 내 판단대로 한다</div>
      </div>
    </div>`;
}

function setStep2(followed){
  S.pendingChoice.followed = followed;
  resolveCard();
}

function resolveCard(){
  const c = S.pendingCard;
  const {checked, followed} = S.pendingChoice;
  let actionKey;
  if(checked && !followed) actionKey='checkThink';
  else if(checked && followed) actionKey='checkFollow';
  else if(!checked && followed) actionKey='skipFollow';
  else actionKey='skipThink';

  const d = DELTA[actionKey];
  applyDelta(d.ri, d.ji);

  let successChance = c.success + S.revealedSet.size*0.06;
  const success = Math.random() < successChance;

  S.history.push({cat:c.cat, actionKey, checked, followed, success, reaction:null});
  S.pendingChoice.success = success;
  S.screen='outcome';
  render();
}

function applyDelta(ri, ji, cb){
  const oldRI=S.RI, oldJI=S.JI;
  if(ri!==undefined) S.RI = Math.max(0, Math.min(100, S.RI+ri));
  if(ji!==undefined) S.JI = Math.max(0, Math.min(100, S.JI+ji));
  // stash for popup rendering after DOM exists
  S._lastDelta = {ri: ri||0, ji: ji||0};
}

function renderOutcome(){
  const c = S.pendingCard;
  const success = S.pendingChoice.success;
  app.innerHTML = `
    ${header(true)}
    <div class="brutal card-panel" style="text-align:center;">
      <div class="outcome-badge ${success?'success':'fail'}">${success?'✅ 성공':'❌ 실패'}</div>
      <p style="font-weight:700; font-size:16px;">${success? c.succTxt : c.failTxt}</p>
      <div class="btn ${success?'lime':'red'} full" onclick="afterOutcome()">${success? '다음으로 →' : '어떻게 받아들일까...'}</div>
    </div>`;
  fireGaugeEffects();
}

function afterOutcome(){
  if(S.pendingChoice.success){
    nextTile();
  } else {
    S.screen='reaction';
    render();
  }
}

function renderReaction(){
  app.innerHTML = `
    ${header(true)}
    <div class="brutal card-panel">
      <h2>결과를 어떻게 받아들일까요?</h2>
      <p class="subtle">결과가 좋지 않았습니다. 이 상황을 뭐라고 말할지가 "책임감 지수"를 바꿉니다.</p>
      <div class="choicegrid">
        <div class="btn red" onclick="react('blameAI')">"AI가 시켰다"</div>
        <div class="btn lime" onclick="react('ownIt')">"내 선택이었다"</div>
      </div>
    </div>`;
}

function react(key){
  const d = DELTA[key];
  applyDelta(d.ri, undefined);
  S.history[S.history.length-1].reaction = key;
  nextTileWithEffect();
}

function nextTileWithEffect(){
  // show a brief gauge-effect screen then move on
  app.innerHTML = `${header(true)}
    <div class="brutal card-panel" style="text-align:center;">
      <p style="font-weight:800; font-size:16px;">지수가 변동했습니다...</p>
    </div>`;
  fireGaugeEffects();
  setTimeout(()=>{ nextTile(); }, 850);
}

function nextTile(){
  S.idx++;
  if(S.idx >= CARDS.length){
    S.screen='ending';
  } else {
    S.screen='board';
  }
  render();
}

function fireGaugeEffects(){
  const d = S._lastDelta || {ri:0, ji:0};
  const riTrack = document.getElementById('ri-track');
  const jiTrack = document.getElementById('ji-track');
  const riFill = document.getElementById('ri-fill');
  const jiFill = document.getElementById('ji-fill');
  if(riFill) riFill.style.width = S.RI + '%';
  if(jiFill) jiFill.style.width = S.JI + '%';
  const riVal = document.getElementById('ri-val');
  const jiVal = document.getElementById('ji-val');
  if(riVal) riVal.textContent = S.RI;
  if(jiVal) jiVal.textContent = S.JI;

  [[riTrack, d.ri],[jiTrack, d.ji]].forEach(([track, val])=>{
    if(!track || !val) return;
    track.classList.remove('shake','flashpos','flashneg');
    void track.offsetWidth; // reflow to restart animation
    track.classList.add(val>0?'flashpos':'flashneg');
    if(Math.abs(val)>=10) track.classList.add('shake');
    const pop = document.createElement('div');
    pop.className = 'popup' + (val<0?' neg':'');
    pop.textContent = (val>0?'+':'') + val;
    track.appendChild(pop);
    setTimeout(()=>pop.remove(), 1150);
  });
}

/* ---------------- ENDING ---------------- */
function computeEnding(){
  const {RI, JI} = S;
  if(RI<40 && JI<40) return {key:'A', em:'🕳️', title:'외주화 파국 엔딩', color:'var(--red)',
    text:'모든 결정을 AI에게 맡기고, 결과에 대한 책임도 지지 않았습니다. 편했지만, 어느새 내 삶의 방향을 내가 정하지 못하게 되었습니다.'};
  if(RI<40 && JI>=60) return {key:'B', em:'🎭', title:'맹목적 순응 엔딩', color:'var(--purple)',
    text:'AI 추천의 허점을 알아챌 판단력은 있었습니다. 하지만 결과가 나쁠 때마다 "AI가 시켰다"며 책임을 미뤘습니다. 알면서도 회피한 것입니다.'};
  if(RI>=60 && JI<40) return {key:'C', em:'🌪️', title:'독단적 과신 엔딩', color:'var(--yellow)',
    text:'결과에 대한 책임은 당당히 졌습니다. 하지만 근거를 따져보지 않고 감으로 밀어붙인 결정이 많았습니다. 용기는 있었지만 성급했습니다.'};
  if(RI>=60 && JI>=60) return {key:'D', em:'🤝', title:'협력적 판단 엔딩', color:'var(--lime)',
    text:'AI를 훌륭한 도구로 활용하면서도, 최종 판단과 그 결과에 대한 책임은 스스로 짊어졌습니다. AI와 사람이 함께 만든 가장 균형 잡힌 결말입니다.'};
  return {key:'E', em:'🌱', title:'성장 진행형 엔딩', color:'var(--cyan)',
    text:'아직 판단력과 책임감의 균형을 찾아가는 중입니다. 실패가 아니라 진행형입니다 — 다음엔 어떤 선택을 바꿔볼지 생각해봅시다.'};
}

function renderEnding(){
  const e = computeEnding();
  const c = counts();
  const ch = CHARACTERS.find(x=>x.id===S.charId);

  const reasons = [];
  reasons.push(`근거를 확인하고 직접 판단한 횟수: <b>${c.checkThink}회</b>`);
  reasons.push(`근거를 확인하고 AI를 따른 횟수: <b>${c.checkFollow}회</b>`);
  reasons.push(`근거 없이 AI를 그대로 따른 횟수: <b>${c.skipFollow}회</b>`);
  reasons.push(`근거 없이 AI를 무시한 횟수: <b>${c.skipThink}회</b>`);
  reasons.push(`나쁜 결과가 나온 횟수: <b>${c.fails}회</b> 중 "내 탓" <b>${c.ownIt}회</b> / "AI 탓" <b>${c.blameAI}회</b>`);
  reasons.push(`최종 판정: RI <b>${S.RI}</b> · JI <b>${S.JI}</b> → 기준선(40/60) 대비 ${e.key==='E' ? '중립대' : (S.RI>=60?'RI 높음':'RI 낮음') + ' · ' + (S.JI>=60?'JI 높음':'JI 낮음')}`);

  app.innerHTML = `
    <div class="brutal endinghero" style="background:${e.color};">
      <span class="em">${e.em}</span>
      <h1>${e.title}</h1>
      <p class="subtle">${ch.em} ${ch.name}의 이야기</p>
    </div>
    <div class="brutal card-panel">
      <p style="font-weight:700; font-size:16px;">${e.text}</p>
      <div class="statbar">
        <div class="statbox"><div class="num">${S.RI}</div><div class="lab">책임감 RI</div></div>
        <div class="statbox"><div class="num">${S.JI}</div><div class="lab">판단력 JI</div></div>
      </div>
    </div>
    <div class="brutal card-panel">
      <h2>판단 근거</h2>
      <ul class="reasonlist">
        ${reasons.map(r=>`<li>${r}</li>`).join('')}
      </ul>
    </div>
    <div class="brutal card-panel">
      <h2>나만의 AI 윤리 헌장</h2>
      <p class="subtle">오늘의 경험을 한 줄로 남겨보세요.</p>
      <textarea id="charter" placeholder="예: AI의 추천은 참고하되, 마지막 결정과 책임은 내가 진다."></textarea>
      <div class="btn full lime" style="margin-top:12px;" onclick="saveCharter()">저장하고 다시 시작 →</div>
    </div>`;
}

function saveCharter(){
  const val = document.getElementById('charter').value;
  try{
    const log = JSON.parse(localStorage.getItem('responsibility_game_log')||'[]');
    log.push({date:new Date().toISOString(), character:S.charId, RI:S.RI, JI:S.JI, charter:val, history:S.history});
    localStorage.setItem('responsibility_game_log', JSON.stringify(log));
  }catch(e){}
  S = {screen:'intro', charId:null, idx:0, RI:50, JI:50, history:[], pendingCard:null, pendingChoice:{}};
  render();
}

function go(screen){ S.screen=screen; render(); }

render();
</script>
</body>
</html>
